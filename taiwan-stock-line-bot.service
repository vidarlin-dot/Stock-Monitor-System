[Unit]
Description=Taiwan Stock LINE Bot Webhook
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/taiwan-stock-line-bot
EnvironmentFile=/opt/taiwan-stock-line-bot/.env
ExecStart=/usr/bin/python3 -m src.line_bot_webhook
Restart=on-failure
RestartSec=10s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/taiwan-stock-line-bot/data /opt/taiwan-stock-line-bot/cache

[Install]
WantedBy=multi-user.target
