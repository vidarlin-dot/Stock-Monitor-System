# LINE Bot Channel credentials (from LINE Console)
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_access_token_here

# Google Cloud service account (JSON string or file path reference)
# Paste the full JSON content as a single line, or use Docker secrets
GCP_SERVICE_ACCOUNT_JSON=

# Google Sheets name (optional, default: Portfolio)
SHEET_NAME=Portfolio
